SIAMUX_DATABASE_URL=postgresql+psycopg://siamux:siamux@localhost:5432/siamux
SIAMUX_BROKER_URL=redis://localhost:6379/0
SIAMUX_PROVIDER_TIMEOUT=5
SIAMUX_MAX_ATTEMPTS=3
SIAMUX_RETRY_BASE_SECONDS=1
SIAMUX_LEASE_SECONDS=30
# Optional HTTP OTLP endpoint (Compose sets an internal Jaeger endpoint):
# SIAMUX_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Client scripts read this from the exported process environment. Issue a key with
# python -m siamux.admin key create --tenant <tenant-id>; no server default exists.
# SIAMUX_API_KEY=<key shown once by the successful create command>
# Backlog caps are stored in the DB; configure with python -m siamux.admin limits.
